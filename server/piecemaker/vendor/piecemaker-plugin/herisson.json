{
  "features": [
    {
      "nom": "ontologie",
      "cible": "^ontologie(\\.proposition)?\\.json$",
      "ecriture": "proposition",
      "skill": "okf",
      "motif": "Only the lawyer sets the link ontology (~/.piecemaker/ontologie.json, common to all cases), in the Index › Ontologie tab. Read it with pm okf ontologie. To propose a change, edit ontologie.json with the Edit or Write tool (or apply_patch), never with the shell: the edit becomes a proposal and the lawyer decides."
    },
    {
      "nom": "arborescence",
      "cible": "^arborescence(\\.proposition)?\\.json$",
      "ecriture": "proposition",
      "skill": "piecemaker",
      "motif": "Only the lawyer sets the folder tree (.piecemaker/arborescence.json), in the Index › Classement tab. To propose a change, edit arborescence.json with the Edit or Write tool (or apply_patch), never with the shell, or run pm dossier arborescence --dossiers: the edit becomes a proposal and the lawyer decides."
    },
    {
      "nom": "okf",
      "cible": "^okf(/|$)",
      "ecriture": "serveur",
      "skill": "okf",
      "motif": "Only the server writes the OKF records (.piecemaker/okf/). You can read them with Read, cat, grep or ls in a command that writes nothing. To add or remove a link, a premise or a party, use pm okf link or pm okf unlink with a relation of the ontology (pm okf ontologie). To record that a document was read and nothing justifies a link, use pm okf examinee <document> --motif \"reason\".",
      "verifier": ["okf", "verify"],
      "commande": "\\bpm okf (link|unlink|examinee)\\b",
      "erreur": "Index OKF : \\d+ erreur|Contradictions : \\d|Graphe : \\d+ élément",
      "delai": 30
    },
    {
      "nom": "features",
      "cible": "^features(/|$)",
      "ecriture": "serveur",
      "skill": "piecemaker",
      "motif": "Only the features MCP writes the feature data and comments (.piecemaker/features/). Use FeatureData to write a document and FeatureComments to answer a comment of the lawyer. Never write these files with Edit, Write or the shell."
    },
    {
      "nom": "etapes",
      "cible": "^etapes\\.json$",
      "ecriture": "serveur",
      "skill": "piecemaker",
      "motif": "Only the lawyer sets the case steps (.piecemaker/etapes.json), on the board of the Suivi des dossiers tab. Read the current step and the document to produce with pm check. Never write this file. To change a step, ask the lawyer."
    },
    {
      "nom": "protection",
      "cible": "^protection\\.json$",
      "ecriture": "serveur",
      "skill": "piecemaker",
      "motif": "Only the PieceMaker server writes the document protection file (.piecemaker/protection.json). Only the lawyer removes the protection, with the shield of the case in the sidebar. Never write this file. Read the converted Markdown of a protected document, not the PDF or the image."
    },
    {
      "nom": "suivi",
      "cible": "^(?<nom>(?:[^/]+-)?suivi\\.json)$",
      "ecriture": "agent",
      "skill": "piecemaker",
      "verifier": ["suivi_dossiers", "verifier", "--suivi", "{nom}"],
      "erreur": "\\d+ erreur\\(s\\), \\d+ manque\\(s\\)\\.",
      "delai": 60,
      "format": "suivi"
    },
    {
      "nom": "memoire",
      "cible": "^memoires/(?<nom>[^/]+)\\.md$",
      "ecriture": "agent",
      "skill": "piecemaker",
      "verifier": ["memoire", "verifier", "--memoire", "{nom}"],
      "delai": 10,
      "format": "memoire"
    },
    {
      "nom": "catala",
      "cible": "^catala/(?<nom>[^/]+)/[^/]+\\.(catala_fr|toml)$",
      "ecriture": "agent",
      "skill": "catala",
      "verifier": ["catala", "verifier", "--programme", "{nom}"],
      "commande": "\\bpm okf (link|unlink)\\b.*\\b(states|involves)\\b",
      "cite": "okf:/_premises/",
      "format": "catala",
      "erreur": ": à corriger\\.",
      "delai": 60
    },
    {
      "nom": "revue",
      "cible": "^(?!)",
      "ecriture": "agent",
      "skill": "piecemaker",
      "verifier": ["tabular_review", "verifier"],
      "commande": "\\bpm tabular_review (preparer|lancer)\\b",
      "erreur": ": bloquée",
      "delai": 30
    }
  ],
  "catalogue": [
    {
      "nom": "case",
      "titre": "Dossier",
      "volet": "dossier",
      "description": "Case state, document conversion, folder tree, filing and the case database: start here with check_case.",
      "skills": [
        {
          "chemin": "vendor/skills/Skill-PieceMaker",
          "references": [
            "check.md",
            "dossier.md"
          ]
        }
      ],
      "demarrage": [
        "Feature run case check_case",
        "Feature read case path=piecemaker/references/dossier.md"
      ],
      "commandes": [
        {
          "nom": "check_case",
          "pm": [
            "check"
          ],
          "role": "Numbered state of the case, in work order; each defect names its fix."
        },
        {
          "nom": "query_database",
          "pm": [
            "dossier",
            "sql"
          ],
          "role": "SQL query on the case database (masked data).",
          "parametres": {
            "query": "#"
          }
        },
        {
          "nom": "convert_documents",
          "pm": [
            "dossier",
            "conversion"
          ],
          "role": "Convert the documents to Markdown (all pending ones without documents).",
          "parametres": {
            "documents": "#?",
            "force": "--force"
          }
        },
        {
          "nom": "read_folder_tree",
          "pm": [
            "dossier",
            "arborescence"
          ],
          "role": "Read the folder tree of the case."
        },
        {
          "nom": "propose_folder_tree",
          "pm": [
            "dossier",
            "arborescence"
          ],
          "role": "Propose a folder tree to the lawyer: folders = [{\"nom\",\"explication\"}].",
          "parametres": {
            "folders": "--dossiers",
            "reason": "--motif"
          }
        },
        {
          "nom": "file_document",
          "pm": [
            "dossier",
            "classer"
          ],
          "role": "File a document in a folder of the tree; it takes the folder type.",
          "parametres": {
            "document": "#",
            "folder": "#"
          }
        },
        {
          "nom": "build_index",
          "pm": [
            "dossier",
            "index",
            "lancer"
          ],
          "role": "Build the document index, or add the missing documents.",
          "parametres": {
            "ai": "--ia",
            "ai_model": "--modele-ia"
          }
        },
        {
          "nom": "read_index",
          "pm": [
            "dossier",
            "index",
            "lire"
          ],
          "role": "Read the document index."
        },
        {
          "nom": "add_index_columns",
          "pm": [
            "dossier",
            "index",
            "colonnes"
          ],
          "role": "Add question columns to the document index.",
          "parametres": {
            "questions": "--questions"
          }
        }
      ]
    },
    {
      "nom": "index",
      "titre": "Index",
      "volet": "index",
      "description": "OKF index of the case documents: cited links between documents, premises, parties and the link ontology.",
      "skills": [
        {
          "chemin": "vendor/skills/okf"
        }
      ],
      "demarrage": [
        "Feature run index verify_index",
        "Feature run index read_ontology"
      ],
      "commandes": [
        {
          "nom": "verify_index",
          "pm": [
            "okf",
            "verify"
          ],
          "role": "Rebuild the OKF records and list errors, contradictions and missing elements."
        },
        {
          "nom": "read_ontology",
          "pm": [
            "okf",
            "ontologie"
          ],
          "role": "Relations allowed between documents (read-only)."
        },
        {
          "nom": "propose_ontology",
          "pm": [
            "okf",
            "ontologie",
            "proposer"
          ],
          "role": "Propose relations and/or document types to the lawyer.",
          "parametres": {
            "ontology": "--json",
            "reason": "--motif"
          }
        },
        {
          "nom": "propose_document_types",
          "pm": [
            "okf",
            "types"
          ],
          "role": "Propose the full catalogue of document types to the lawyer.",
          "parametres": {
            "types": "--json",
            "reason": "--motif"
          }
        },
        {
          "nom": "link",
          "pm": [
            "okf",
            "link"
          ],
          "role": "Cited link: document relation document, document states \"premise\", or \"premise\" involves PARTY.",
          "parametres": {
            "source": "#",
            "relation": "#",
            "target": "#",
            "citation": "--citation",
            "value": "--value",
            "single": "--single"
          }
        },
        {
          "nom": "unlink",
          "pm": [
            "okf",
            "unlink"
          ],
          "role": "Remove a link.",
          "parametres": {
            "source": "#",
            "relation": "#",
            "target": "#"
          }
        },
        {
          "nom": "mark_examined",
          "pm": [
            "okf",
            "examinee"
          ],
          "role": "Mark a document as read with nothing to link (remove = undo).",
          "parametres": {
            "document": "#",
            "reason": "--motif",
            "remove": "--retirer"
          }
        }
      ]
    },
