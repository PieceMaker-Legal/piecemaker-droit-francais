{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "paths": { "@/*": ["../../src/*"], "@piecemaker/*": ["../../shared/piecemaker/*"] },
    "strict": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../src/vite-env.d.ts"]
}
